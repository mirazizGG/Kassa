# ================================================================
#  SmartKassa backend — muhit sozlamalari (namuna)
# ================================================================
#  Bu faylni  backend/.env  ga nusxalang va qiymatlarni to'ldiring.
#  backend/.env  git'ga TUSHMAYDI (.gitignore). Bu faylda esa
#  HECH QACHON haqiqiy sir bo'lmasin — faqat namuna qiymatlar.
#
#      cp backend/.env.example backend/.env      (Windows: copy)
# ----------------------------------------------------------------

# --- Muhit ---
# development (default) yoki production.
# production bo'lsa: SECRET_KEY majburiy va namunaviy bo'lsa dastur ishga tushmaydi.
APP_ENV=development

# --- JWT imzo kaliti (MAJBURIY, production'da) ---
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# --- Bosh admin boshlang'ich paroli ---
# FAQAT bazada hech qanday admin bo'lmaganda ishlatiladi (birinchi ishga tushirish
# yoki bazani yo'qotib qayta tiklashda). Login nomi: miraziz (kodda qat'iy, .env'dan
# sozlanmaydi). Bo'sh qoldirilsa: development'da "8038434", production'da esa
# admin yaratish kerak bo'lganda sozlama xatosi beriladi.
PRIMARY_ADMIN_PASSWORD=change_me_strong_admin_password

# --- CORS: so'rov qabul qilinadigan manzillar ---
# Vergul bilan ajrating. production'da "*" QO'YMANG — o'z domeningizni yozing.
# Backend frontendni o'zi bergani uchun (bir origin) ko'pincha bitta domen yetadi.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ma'lumotlar bazasi ---
# Bo'sh/berilmagan bo'lsa: backend/market.db (SQLite).
#
# SERVERDA (VPS) PostgreSQL tavsiya etiladi: SQLite bir vaqtda faqat bitta
# yozuvchiga ruxsat beradi, ikki kassa parallel ishlaganda "database is locked"
# xatosi chiqadi. postgres:// va postgresql:// URL lari avtomatik +asyncpg ga
# o'giriladi (database.py), shuning uchun quyidagi ko'rinish yetarli:
#   DATABASE_URL=postgresql://kassa:PAROL@localhost:5432/kassa
DATABASE_URL=sqlite+aiosqlite:///./market.db

# --- Do'kon vaqt mintaqasi ---
# Bazada hamma vaqt UTC saqlanadi; foydalanuvchiga ko'rsatiladigan "kun"
# chegaralari va smena hisoblari shu mintaqa bo'yicha hisoblanadi.
# Serverning o'z soati qanday bo'lishidan QAT'I NAZAR ishlaydi — hostingda
# server odatda UTC da bo'ladi va bu normal.
SHOP_TIMEZONE=Asia/Tashkent

# --- Fon vazifalari (rejalashtiruvchi + Telegram bot + zahira nusxa) ---
# Ular YAGONA jarayonda ishlashi kerak. `uvicorn --workers 4` bilan ishlatganda
# har bir workerda takrorlanardi: Telegram 409 Conflict qaytaradi, qarzdorlar
# bir necha marta eslatma oladi, zahira vazifalari bir-biriga xalaqit beradi.
# Serverda buni systemd unit fayllari belgilaydi (web=false, worker=true),
# deploy/systemd/ ga qarang. Bitta jarayonda ishlatilsa - true.
RUN_BACKGROUND_JOBS=true

# --- Teskari proksi (Caddy / nginx / Cloudflare) ---
# true bo'lsa backend X-Forwarded-For va CF-Connecting-IP sarlavhalariga ishonadi.
# FAQAT proksi bu sarlavhalarni o'zi qayta yozadigan bo'lsa yoqing: aks holda
# istalgan mijoz uni o'zi yasab, login urinishlari chegarasini chetlab o'tadi.
TRUST_PROXY_HEADERS=false

# --- Ilova ichidan yangilash ("Yangilash" tugmasi) ---
# true bo'lsa xodimlar ilova ichidan GitHub'dan yangilay oladi. Faqat asosiy serverda.
ALLOW_SELF_UPDATE=false

# --- Zaxira nusxa (backup) ---
# PostgreSQL da nusxa `pg_dump` orqali olinadi (custom format, .dump fayl).
# Serverda postgresql-client o'rnatilgan bo'lishi shart:
#   sudo apt install postgresql-client
# Tiklash:  pg_restore --clean --if-exists -d "$DATABASE_URL" backup_XXXX.dump
# pg_dump PATH da bo'lmasa, to'liq yo'lni ko'rsating:
# PG_DUMP_PATH=/usr/bin/pg_dump
BACKUP_ENABLED=true
# Kun davomida qaysi soatlarda (vergul bilan, 0-23). Har ishga tushganda ham olinadi.
BACKUP_HOURS=12,22
# Nechta oxirgi nusxa saqlansin.
BACKUP_RETENTION=30
# Har nusxa shu papkaga ham ko'chiriladi (tashqi disk / bulut sinxron papka). Bo'sh = faqat lokal.
BACKUP_MIRROR_DIR=

# GitHub'ga zaxira — ALOHIDA MAXFIY repozitoriy (kod repo'si EMAS!).
# Fine-grained token: faqat o'sha repo, "Contents" -> Read and write.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=egangiz/kassa-backups
BACKUP_GITHUB_PATH=market.db
BACKUP_GITHUB_BRANCH=main

# --- Telegram bot (ixtiyoriy) ---
# BotFather bergan token. Bo'sh bo'lsa bot ishga tushmaydi (dastur baribir ishlaydi).
TELEGRAM_BOT_TOKEN=
# Admin chat ID — kunlik zaxira nusxa shu chatga ham fayl bo'lib yuboriladi.
TELEGRAM_ADMIN_CHAT_ID=
