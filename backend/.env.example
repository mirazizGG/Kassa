# ================================================================
#  SmartKassa backend — muhit sozlamalari (namuna)
# ================================================================
#  Bu faylni  backend/.env  ga nusxalang va qiymatlarni to'ldiring.
#  backend/.env  git'ga TUSHMAYDI (.gitignore). Bu faylda esa
#  HECH QACHON haqiqiy sir bo'lmasin — faqat namuna qiymatlar.
#
#      cp backend/.env.example backend/.env      (Windows: copy)
# ----------------------------------------------------------------

# --- Muhit ---
# development (default) yoki production.
# production bo'lsa: SECRET_KEY majburiy va namunaviy bo'lsa dastur ishga tushmaydi.
APP_ENV=development

# --- JWT imzo kaliti (MAJBURIY, production'da) ---
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_generate_with_secrets_token_hex_32

# --- Bosh admin boshlang'ich paroli ---
# FAQAT bazada hech qanday admin bo'lmaganda ishlatiladi (birinchi ishga tushirish
# yoki bazani yo'qotib qayta tiklashda). Login nomi: miraziz (kodda qat'iy, .env'dan
# sozlanmaydi). Bo'sh qoldirilsa: development'da "changeme-dev", production'da esa
# admin yaratish kerak bo'lganda sozlama xatosi beriladi.
PRIMARY_ADMIN_PASSWORD=change_me_strong_admin_password

# --- CORS: so'rov qabul qilinadigan manzillar ---
# Vergul bilan ajrating. production'da "*" QO'YMANG — o'z domeningizni yozing.
# Backend frontendni o'zi bergani uchun (bir origin) ko'pincha bitta domen yetadi.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Ma'lumotlar bazasi ---
# Bo'sh/berilmagan bo'lsa: backend/market.db (SQLite). PostgreSQL uchun:
#   DATABASE_URL=postgresql://kassa:PAROL@localhost:5432/kassa
DATABASE_URL=sqlite+aiosqlite:///./market.db

# --- Ilova ichidan yangilash ("Yangilash" tugmasi) ---
# true bo'lsa xodimlar ilova ichidan GitHub'dan yangilay oladi. Faqat asosiy serverda.
ALLOW_SELF_UPDATE=false

# --- Zaxira nusxa (backup) ---
BACKUP_ENABLED=true
# Kun davomida qaysi soatlarda (vergul bilan, 0-23). Har ishga tushganda ham olinadi.
BACKUP_HOURS=12,22
# Nechta oxirgi nusxa saqlansin.
BACKUP_RETENTION=30
# Har nusxa shu papkaga ham ko'chiriladi (tashqi disk / bulut sinxron papka). Bo'sh = faqat lokal.
BACKUP_MIRROR_DIR=

# GitHub'ga zaxira — ALOHIDA MAXFIY repozitoriy (kod repo'si EMAS!).
# Fine-grained token: faqat o'sha repo, "Contents" -> Read and write.
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=egangiz/kassa-backups
BACKUP_GITHUB_PATH=market.db
BACKUP_GITHUB_BRANCH=main

# --- Telegram bot (ixtiyoriy) ---
# BotFather bergan token. Bo'sh bo'lsa bot ishga tushmaydi (dastur baribir ishlaydi).
TELEGRAM_BOT_TOKEN=
# Admin chat ID — kunlik zaxira nusxa shu chatga ham fayl bo'lib yuboriladi.
TELEGRAM_ADMIN_CHAT_ID=
