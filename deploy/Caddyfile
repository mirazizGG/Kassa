# SmartKassa — Caddy FAQAT internet orqali kirish kerak bo'lganda ishlatiladi
# (Cloudflare Tunnel bilan birga). Do'kon ichidan (LAN) kirish uchun Caddy
# KERAK EMAS — backend'ning o'zi :8000 da frontendni ham beradi.
#
# Bu yerda Caddy hech nima ajratmaydi: hamma so'rovni backendga uzatadi.
# Backend API ham, frontend statik fayllar ham, SPA routing ham o'zida.

:8080 {
	encode gzip zstd
	reverse_proxy 127.0.0.1:8000

	log {
		output file {$KASSA_DEPLOY}/run/caddy.log {
			roll_size 10MB
			roll_keep 5
		}
	}
}
