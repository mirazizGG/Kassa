# ====== SmartKassa backend (.env) ======
# Bu faylni  backend/.env  ga nusxalang va to'ldiring.
# backend/.env  git ga YUKLANMAYDI (.gitignore da).

# --- Muhit ---
# production bo'lsa: SECRET_KEY o'rnatilmagan yoki namunaviy bo'lsa, dastur
# ishga tushmaydi (xavfsizlik uchun). Do'kon serverida doim: production
APP_ENV=production

# --- Xavfsizlik (MAJBURIY o'zgartiring) ---
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BU_YERGA_TASODIFIY_64_BELGILI_KALIT

# Faqat shu manzillardan so'rov qabul qilinadi.
# Bitta origin ishlatilyapti (Caddy reverse proxy), shuning uchun asosan
# CORS kerak emas, lekin ehtiyot uchun to'g'ri domenni yozing.
ALLOWED_ORIGINS=https://kassa.SIZNING-DOMEN

# --- Baza ---
# Boshida SQLite yetadi. 10+ kishi bir vaqtda ishlaganda "database is locked"
# chiqsa, PostgreSQL ga o'ting (pastdagi qatorni oching):
DATABASE_URL=sqlite+aiosqlite:///./market.db
# DATABASE_URL=postgresql://kassa:PAROL@localhost:5432/kassa

# --- Ilova ichidan yangilash ("Yangilash" tugmasi) ---
# true bo'lsa, xodimlar ilova ichidagi tugma orqali serverni GitHub'dan
# yangilay oladi. Faqat do'kondagi ASOSIY serverda true qo'ying.
ALLOW_SELF_UPDATE=true

# --- Backup ---
BACKUP_ENABLED=true
# Kun davomida qaysi soatlarda nusxa olinsin (vergul bilan, 0-23).
# Bundan tashqari server har ishga tushganda ham bitta nusxa oladi.
BACKUP_HOURS=12,22
BACKUP_RETENTION=30
# Har zahira nusxa shu papkaga ham ko'chiriladi (tashqi disk yoki
# Google Drive / OneDrive sinxron papkasi). Bo'sh bo'lsa faqat lokal saqlanadi.
# TAVSIYA ETILADI — bitta disk ishdan chiqsa ma'lumot yo'qolmasligi uchun.
# Namuna:  BACKUP_MIRROR_DIR=D:\kassa-backup
BACKUP_MIRROR_DIR=

# GitHub'ga zaxira nusxa — ALOHIDA MAXFIY repozitoriy (kod repo'si emas!).
# Har zaxira o'sha repodagi bitta faylni eskisi ustiga yozadi.
#   1) GitHub'da yangi PRIVATE repo oching, masalan  kassa-backups
#   2) Fine-grained Personal Access Token: faqat shu repo, "Contents" -> Read and write
#   3) Quyidagilarni to'ldiring:
# BACKUP_GITHUB_TOKEN=github_pat_...
# BACKUP_GITHUB_REPO=egangiz/kassa-backups
# BACKUP_GITHUB_PATH=market.db
# BACKUP_GITHUB_BRANCH=main

# --- Telegram bot (ixtiyoriy) ---
# TELEGRAM_ADMIN_CHAT_ID to'ldirilgan bo'lsa, kunlik zahira nusxa har kuni
# admin Telegram'iga ham fayl bo'lib yuboriladi.
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
