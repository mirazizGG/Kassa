# ====== SmartKassa backend (.env) ======
# Bu faylni  backend/.env  ga nusxalang va to'ldiring.
# backend/.env  git ga YUKLANMAYDI (.gitignore da).

# --- Xavfsizlik (MAJBURIY o'zgartiring) ---
# Yangi kalit yaratish:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=BU_YERGA_TASODIFIY_64_BELGILI_KALIT

# Faqat shu manzillardan so'rov qabul qilinadi.
# Bitta origin ishlatilyapti (Caddy reverse proxy), shuning uchun asosan
# CORS kerak emas, lekin ehtiyot uchun to'g'ri domenni yozing.
ALLOWED_ORIGINS=https://kassa.SIZNING-DOMEN

# --- Baza ---
# Boshida SQLite yetadi. 10+ kishi bir vaqtda ishlaganda "database is locked"
# chiqsa, PostgreSQL ga o'ting (pastdagi qatorni oching):
DATABASE_URL=sqlite+aiosqlite:///./market.db
# DATABASE_URL=postgresql://kassa:PAROL@localhost:5432/kassa

# --- Backup ---
BACKUP_ENABLED=true
BACKUP_HOUR=2
BACKUP_RETENTION=30

# --- Telegram bot (ixtiyoriy) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
