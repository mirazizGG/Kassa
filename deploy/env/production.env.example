# ================================================================
#  SmartKassa - SERVER (production) sozlamalari
# ================================================================
#  Nusxalang va to'ldiring:
#     cp deploy/env/production.env.example deploy/env/production.env
#     chmod 600 deploy/env/production.env
#  Bu faylda HAQIQIY parollar bo'ladi - git'ga tushmasin.
# ----------------------------------------------------------------

APP_ENV=production

# JWT imzo kaliti. MAJBURIY va noyob bo'lishi shart.
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Bosh admin boshlang'ich paroli. Faqat bazada admin YO'Q bo'lganda ishlatiladi.
# Ma'lumot ko'chirilgandan keyin admin allaqachon bor - bu qiymat ishlatilmaydi.
PRIMARY_ADMIN_PASSWORD=

# --- Ma'lumotlar bazasi ---
DATABASE_URL=postgresql://kassa:PAROL@localhost:5432/kassa

# --- Do'kon vaqt mintaqasi ---
# Serverning o'z soati UTC bo'lishi normal - hisoblar shu mintaqa bo'yicha.
SHOP_TIMEZONE=Asia/Tashkent

# --- Teskari proksi ---
# Caddy X-Forwarded-For ni o'zi qayta yozadi, shuning uchun true.
TRUST_PROXY_HEADERS=true

# --- CORS ---
# Backend frontendni o'zi bergani uchun bitta domen yetadi. "*" QO'YMANG.
ALLOWED_ORIGINS=https://smart-kassa.uz,https://www.smart-kassa.uz

# --- Fon vazifalari ---
# Bu qiymatni systemd unit fayllari o'zi belgilaydi (web=false, worker=true).
# Bu yerda YOZMANG.

# --- Ilova ichidan yangilash ---
# Serverda O'CHIRIQ tavsiya etiladi: yangilash deploy/scripts/update.sh orqali,
# do'kon yopilgandan keyin, qo'lda bajariladi.
ALLOW_SELF_UPDATE=false

# --- Zahira nusxa ---
BACKUP_ENABLED=true
BACKUP_HOURS=12,22
BACKUP_RETENTION=30
# pg_dump PATH da bo'lmasa to'liq yo'l:
# PG_DUMP_PATH=/usr/bin/pg_dump
# Tashqi disk yoki bulut sinxron papka:
BACKUP_MIRROR_DIR=

# GitHub'ga zahira - ALOHIDA MAXFIY repozitoriy (kod repo'si EMAS).
BACKUP_GITHUB_TOKEN=
BACKUP_GITHUB_REPO=
BACKUP_GITHUB_PATH=kassa.dump
BACKUP_GITHUB_BRANCH=main

# --- Telegram bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
