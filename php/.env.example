# Kassa (PHP) — sozlamalar namunasi
#
# Bu faylni `.env` nomi bilan nusxalang va to'ldiring:
#     cp .env.example .env && chmod 600 .env
#
# .env ni HECH QACHON repozitoriyga qo'shmang va veb orqali ochiq qoldirmang.
# public/.htaccess uni bloklaydi, lekin fayl public/ dan TASHQARIDA turishi
# eng ishonchli yo'l.

# --------------------------------------------------------------------------
# Muhit
# --------------------------------------------------------------------------
# development | production
# production'da: xatolar ekranga chiqmaydi va zaif SECRET_KEY bilan ilova
# umuman ishga tushmaydi.
APP_ENV=production

# JWT imzo kaliti. KAMIDA 32 belgi, tasodifiy.
# Yangi kalit yasash:
#     php -r "echo bin2hex(random_bytes(32)), PHP_EOL;"
# Kalit ochiq qolsa — istalgan odam o'ziga admin token yasay oladi.
SECRET_KEY=

# --------------------------------------------------------------------------
# Baza
# --------------------------------------------------------------------------
# MySQL / MariaDB (cPanel'da odatiy tanlov):
DATABASE_URL=mysql://foydalanuvchi:parol@localhost/baza_nomi
#
# PostgreSQL:
# DATABASE_URL=postgresql://foydalanuvchi:parol@localhost:5432/baza_nomi
#
# SQLite (faqat ishlab chiqish uchun — bir vaqtda bitta yozuvchi):
# DATABASE_URL=sqlite:/home/foydalanuvchi/kassa/market.db
#
# Parolda @ : / ? # kabi belgilar bo'lsa, ularni foizli kodlang
# (masalan @ -> %40), aks holda manzil noto'g'ri o'qiladi.

# MySQL unix soketi (kerak bo'lsa; odatda bo'sh qoldiriladi)
# DB_SOCKET=/var/lib/mysql/mysql.sock

# Doimiy ulanish. Sukut: false.
# Shared hosting'da true qilish max_connections ni tez tugatishi mumkin.
DB_PERSISTENT=false

# --------------------------------------------------------------------------
# Birinchi admin
# --------------------------------------------------------------------------
# FAQAT bazada birorta admin bo'lmaganda ishlatiladi (bin/setup.php).
# Login "miraziz" — u kodda qat'iy yozilgan va sozlanmaydi.
# Ma'lumot ko'chirilgandan keyin bu qiymat ishlatilmaydi: xodimlar
# o'zlarining ESKI parollari bilan kiradi.
PRIMARY_ADMIN_PASSWORD=

# --------------------------------------------------------------------------
# Do'kon
# --------------------------------------------------------------------------
# Har qanday "kun" chegarasi va ko'rsatiladigan vaqtlar shunga bog'liq.
# Serverning O'Z soati ahamiyatsiz — hosting odatda UTC da turadi va
# shunday bo'lgani ma'qul.
SHOP_TIMEZONE=Asia/Tashkent

# Nakladnoy fotolari qayerda yotadi.
#
# Sukut bo'yicha <ilova>/public/uploads. Agar sayt ildizi ilovadan ALOHIDA
# bo'lsa (fayllar public_html ga ko'chirilgan), bu yo'lni ANIQ ko'rsating —
# aks holda yangi fotolar saqlanadi, lekin ochilmaydi: ilova bir joyga
# yozadi, veb-server boshqa joydan o'qiydi.
# UPLOAD_DIR=/home/foydalanuvchi/public_html/uploads

# --------------------------------------------------------------------------
# Tarmoq
# --------------------------------------------------------------------------
# Frontend va API bitta manzilda bo'lsa (odatdagi holat) — BO'SH qoldiring,
# CORS umuman kerak emas.
# Alohida domendan chaqirish kerak bo'lsa, ro'yxat vergul bilan:
# ALLOWED_ORIGINS=https://smart-kassa.uz,https://www.smart-kassa.uz
ALLOWED_ORIGINS=

# Reverse-proxy (Cloudflare, nginx) ORQASIDA bo'lsagina true.
# Aks holda istalgan mijoz X-Forwarded-For ni O'ZI yasab, har so'rovda
# boshqa "IP" ko'rsatib, kirish urinishlari chegarasini chetlab o'tadi.
TRUST_PROXY_HEADERS=false

# Ilova domen ostidagi papkada bo'lsa (masalan https://sayt.uz/kassa):
# APP_BASE_PATH=/kassa

# --------------------------------------------------------------------------
# Zahira nusxa
# --------------------------------------------------------------------------
# Nusxa cron orqali olinadi (bin/backup.php) va "Zahira" tugmasi bilan.
BACKUP_ENABLED=true

# Nechta nusxa saqlansin (baza va nakladnoylar uchun ALOHIDA hisoblanadi).
BACKUP_RETENTION=30

# Nusxalar qayerga tushsin. Bo'sh qoldirilsa — <ilova>/backups
# BACKUP_DIR=/home/foydalanuvchi/kassa-backups

# --------------------------------------------------------------------------
# Yangilash
# --------------------------------------------------------------------------
# Ilova ichidan yangilash. Shared hosting'da ishlamaydi — false qoldiring.
ALLOW_SELF_UPDATE=false
